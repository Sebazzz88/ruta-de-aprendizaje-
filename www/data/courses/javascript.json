    {
      "level": "intermedio",
      "title": "Bucles y funciones",
      "description": "Repite tareas y crea funciones.",
      "lessons": [
        {
          "id": "js-3-1",
          "title": "Bucles",
          "exercises": [
            {
              "type": "output",
              "code": "for (let i = 0; i < 3; i++) {\n  console.log(i);\n}",
              "options": [
                "0\n1\n2",
                "1\n2\n3",
                "0\n1\n2\n3",
                "3"
              ],
              "answer": 0,
              "explanation": "i empieza en 0 y el bucle se detiene cuando i llega a 3."
            },
            {
              "type": "fill",
              "prompt": "Recorre los valores del arreglo",
              "code": "const frutas = [\"pera\", \"uva\"];\nfor (const f ___ frutas) {\n  console.log(f);\n}",
              "options": [
                "of",
                "in",
                "on",
                "from"
              ],
              "answer": [
                "of"
              ],
              "explanation": "for...of recorre valores; for...in recorre índices o claves."
            },
            {
              "type": "output",
              "code": "let total = 0;\nfor (const n of [1, 2, 3]) {\n  total += n;\n}\nconsole.log(total);",
              "options": [
                "6",
                "123",
                "3",
                "0"
              ],
              "answer": 0,
              "explanation": "Se suman 1 + 2 + 3 = 6."
            },
            {
              "type": "choice",
              "prompt": "¿Qué hace continue en un bucle?",
              "options": [
                "Salta a la siguiente vuelta",
                "Sale del bucle",
                "Detiene el programa",
                "Repite la vuelta actual"
              ],
              "answer": 0,
              "explanation": "continue omite el resto de la vuelta actual y pasa a la siguiente."
            },
            {
              "type": "order",
              "prompt": "Ordena para imprimir 3, 2 y 1",
              "lines": [
                "let n = 3;",
                "while (n > 0) {",
                "  console.log(n);",
                "  n--;",
                "}"
              ],
              "explanation": "Primero se imprime y luego se resta 1."
            }
          ]
        },

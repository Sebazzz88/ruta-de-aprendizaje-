            {
              "type": "choice",
              "prompt": "¿Qué función libera la memoria reservada con malloc?",
              "options": [
                "free()",
                "delete",
                "release()",
                "clear()"
              ],
              "answer": 0,
              "explanation": "Cada malloc debe tener su free para evitar fugas de memoria."
            },
            {
              "type": "output",
              "code": "int *v = malloc(2 * sizeof(int));\nv[0] = 4;\nv[1] = 6;\nprintf(\"%d\", v[0] * v[1]);\nfree(v);",
              "options": [
                "24",
                "10",
                "46",
                "Error"
              ],
              "answer": 0,
              "explanation": "4 × 6 = 24."
            },
            {
              "type": "choice",
              "prompt": "¿Qué devuelve malloc si no hay memoria suficiente?",
              "options": [
                "NULL",
                "0 bytes",
                "-1",
                "Un error de compilación"
              ],
              "answer": 0,
              "explanation": "Siempre conviene comprobar si malloc devolvió NULL."
            },
            {
              "type": "order",
              "prompt": "Ordena el uso correcto de la memoria",
              "lines": [
                "int *p = malloc(sizeof(int));",
                "*p = 42;",
                "printf(\"%d\", *p);",
                "free(p);"

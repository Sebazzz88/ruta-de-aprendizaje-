          ]
        },
        {
          "id": "js-1-2",
          "title": "Variables",
          "exercises": [
            {
              "type": "choice",
              "prompt": "¿Qué palabra declara una variable que NO se puede reasignar?",
              "options": [
                "const",
                "let",
                "var",
                "static"
              ],
              "answer": 0,
              "explanation": "const crea una referencia que no se puede volver a asignar."
            },
            {
              "type": "output",
              "code": "let x = 5;\nx = x * 2;\nconsole.log(x);",
              "options": [
                "10",
                "5",
                "25",
                "Error"
              ],
              "answer": 0,
              "explanation": "x vale 5 y luego se multiplica por 2."
            },
            {
              "type": "fill",
              "prompt": "Declara una variable que luego cambia",
              "code": "___ nombre = \"Ana\";\nnombre = \"Luis\";",
              "options": [
                "let",
                "const",
                "def",
                "int"
              ],
              "answer": [
                "let"
              ],
              "explanation": "let permite reasignar. Con const, la segunda línea daría error."
            },
            {
              "type": "output",
              "code": "const a = 7;\nconst b = 2;\nconsole.log(a % b);",
              "options": [
                "1",
                "3.5",
                "3",
                "2"
              ],
              "answer": 0,

              "type": "order",
              "prompt": "Ordena para que imprima 35",
              "lines": [
                "let precio = 10;",
                "let total = precio * 3;",
                "total = total + 5;",
                "console.log(total);"
              ],
              "explanation": "10 × 3 = 30, más 5 = 35."
            }
          ]
        }
      ]
    },
    {

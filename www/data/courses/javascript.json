              "answer": 0,
              "explanation": "console.log() escribe en la consola del navegador o de Node.js."
            },
            {
              "type": "fill",
              "prompt": "Completa para mostrar Hola",
              "code": "console.___(\"Hola\");",
              "options": [
                "log",
                "print",
                "write",
                "show"
              ],
              "answer": [
                "log"
              ],
              "explanation": "El método es console.log()."
            },
            {
              "type": "output",
              "code": "console.log(\"3\" + 4);",
              "options": [
                "34",
                "7",
                "Error",
                "\"3\"4"

                "// comentario",
                "# comentario",
                "<!-- comentario -->",
                "-- comentario"
              ],
              "answer": 0,
              "explanation": "En JavaScript, // inicia un comentario de una línea."
            },
            {
              "type": "order",
              "prompt": "Ordena para mostrar A, B y C",
              "lines": [
                "console.log(\"A\");",
                "console.log(\"B\");",
                "console.log(\"C\");"
              ],
              "explanation": "Las instrucciones se ejecutan de arriba hacia abajo."

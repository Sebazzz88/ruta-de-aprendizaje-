        {
          "id": "js-2-2",
          "title": "Condicionales",
          "exercises": [
            {
              "type": "output",
              "code": "const edad = 15;\nif (edad >= 18) {\n  console.log(\"Adulto\");\n} else {\n  console.log(\"Menor\");\n}",
              "options": [
                "Menor",
                "Adulto",
                "Error",
                "Nada"
              ],
              "answer": 0,
              "explanation": "15 no es mayor o igual que 18, así que se ejecuta el else."
            },
            {
              "type": "fill",
              "prompt": "Completa la condición",
              "code": "const x = 10;\n___ (x > 5) {\n  console.log(\"Grande\");\n}",
              "options": [
                "if",
                "when",
                "for",
                "case"
              ],
              "answer": [
                "if"
              ],
              "explanation": "if (condición) { ... } ejecuta el bloque si la condición es verdadera."
            },
            {
              "type": "output",
              "code": "const n = 4;\nconsole.log(n % 2 === 0 ? \"par\" : \"impar\");",
              "options": [
                "par",
                "impar",
                "true",
                "0"
              ],
              "answer": 0,
              "explanation": "El operador ternario elige \"par\" porque 4 % 2 es 0."
            },
            {
              "type": "choice",
              "prompt": "¿Qué operador significa \"y\" lógico?",
              "options": [
                "&&",
                "||",
                "!",
                "??"
              ],
              "answer": 0,
              "explanation": "&& es \"y\"; || es \"o\"; ! es \"no\"."
            },
            {
              "type": "order",
              "prompt": "Ordena el programa",
              "lines": [
                "const nota = 8;",
                "if (nota >= 6) {",
                "  console.log(\"Aprobado\");",
                "} else {",
                "  console.log(\"Reprobado\");",
                "}"
              ],
              "explanation": "Las llaves abren y cierran cada bloque."
            }
          ]
        }
      ]
